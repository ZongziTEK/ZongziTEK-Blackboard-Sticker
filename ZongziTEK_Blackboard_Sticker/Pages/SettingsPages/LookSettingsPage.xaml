<Page x:Class="ZongziTEK_Blackboard_Sticker.Pages.SettingsPages.LookSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern" xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:card="clr-namespace:ZongziTEK_Blackboard_Sticker.Controls.Cards"
      xmlns:local="clr-namespace:ZongziTEK_Blackboard_Sticker.Pages.SettingsPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LookSettingsPage">

    <Page.Resources>
        <local:HexColorBrushConverter x:Key="HexColorBrushConverter"/>
        <local:CustomBackgroundStyleVisibilityConverter x:Key="CustomBackgroundStyleVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <ui:ScrollViewerEx>
            <ikw:SimpleStackPanel Spacing="8" Margin="24">
                <Label FontSize="24" Content="外观" Margin="12,8" FontWeight="Bold"/>
                <card:SliderCard x:Name="CardWindowScaleMultiplier" Icon="{x:Static ui:FluentSystemIcons.ScaleFit_20_Regular}" Header="界面缩放" Tip="当黑板贴的界面过大或过小时，需要调节此设置项" 
                                 Value="{Binding WindowScaleMultiplier, Mode=TwoWay}" 
                                 Minimum="0.5" Maximum="2.0" Unit="倍" NumberFormat="0.##"
                                 IsResetButtonVisible="True" ResetClicked="CardWindowScaleMultiplier_ResetClicked"
                                 ValueChanged="SliderWindowScaleMultiplier_ValueChanged"
                                 ValueChangeStart="SliderWindowScaleMultiplier_ValueChangeStart"
                                 ValueChangeEnd="SliderWindowScaleMultiplier_ValueChangeEnd"/>
                <card:GenericSettingsCard x:Name="CardTheme" Icon="{x:Static ui:FluentSystemIcons.PaintBrush_20_Regular}" Header="颜色主题"
                                          IsResetButtonVisible="True" ResetClicked="CardTheme_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ComboBox Width="180" SelectedIndex="{Binding Theme}" SelectionChanged="ComboBoxTheme_SelectionChanged">
                            <ComboBoxItem>跟随系统（默认）</ComboBoxItem>
                            <ComboBoxItem>浅色</ComboBoxItem>
                            <ComboBoxItem>深色</ComboBoxItem>
                        </ComboBox>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <Label FontSize="14" Margin="12,8,0,0" Content="背景" Opacity="0.8"/>
                <card:GenericSettingsCard x:Name="CardBackgroundStyle" Icon="{x:Static ui:FluentSystemIcons.PaintBrush_20_Regular}" Header="背景风格"
                                          IsResetButtonVisible="True" ResetClicked="CardBackgroundStyle_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="180" SelectedIndex="{Binding BackgroundStyle}" SelectionChanged="ComboBoxBackgroundStyle_SelectionChanged">
                                <ComboBoxItem>原生</ComboBoxItem>
                                <ComboBoxItem>清爽</ComboBoxItem>
                                <ComboBoxItem>简化</ComboBoxItem>
                                <ComboBoxItem>全透</ComboBoxItem>
                                <ComboBoxItem>自定义</ComboBoxItem>
                            </ComboBox>
                            <Button Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="编辑自定义背景"
                                    Visibility="{Binding BackgroundStyle, Converter={StaticResource CustomBackgroundStyleVisibilityConverter}}"
                                    Click="ButtonExpandCustomBackgroundEditor_Click">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Edit_20_Regular}" FontSize="18"/>
                            </Button>
                        </ikw:SimpleStackPanel>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <Border x:Name="CustomBackgroundEditorHost"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        Visibility="{Binding BackgroundStyle, Converter={StaticResource CustomBackgroundStyleVisibilityConverter}}">
                    <Expander x:Name="CustomBackgroundEditorExpander"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              ui:ControlHelper.CornerRadius="4"
                              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              Style="{DynamicResource {x:Static ui:ThemeKeys.ExpanderCardStyleKey}}"
                              IsExpanded="False"
                              MinHeight="68">
                        <Expander.Header>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="14">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PaintBrush_20_Regular}" FontSize="20" Margin="-2,0,0,0"/>
                                <Label Content="编辑自定义背景" VerticalContentAlignment="Center"/>
                            </ikw:SimpleStackPanel>
                        </Expander.Header>

                        <ItemsControl ItemsSource="{Binding BackgroundStyleCategories, RelativeSource={RelativeSource AncestorType={x:Type local:LookSettingsPage}}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              ui:ControlHelper.CornerRadius="4"
                                              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                              Style="{DynamicResource {x:Static ui:ThemeKeys.ExpanderCardStyleKey}}"
                                              IsExpanded="True"
                                              Margin="0,0,0,8">
                                        <Expander.Header>
                                            <Label Content="{Binding Header}" VerticalContentAlignment="Center"/>
                                        </Expander.Header>

                                        <ikw:SimpleStackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="本类批量" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}"/>
                                                <Border Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="4"
                                                        Margin="0,0,8,0"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding BatchColor, Converter={StaticResource HexColorBrushConverter}}"/>
                                                <TextBox Grid.Column="2"
                                                         Width="88"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding BatchColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         LostFocus="CustomBackgroundColorTextBox_LostFocus"
                                                         KeyDown="CustomBackgroundColorTextBox_KeyDown"/>
                                                <card:NumberSettingEditor Grid.Column="3"
                                                                          Margin="12,0,8,0"
                                                                          Value="{Binding BatchOpacity, Mode=TwoWay}"
                                                                          Minimum="0"
                                                                          Maximum="100"
                                                                          TickFrequency="1"
                                                                          Unit="%"
                                                                          NumberFormat="0"
                                                                          InputWidth="56"/>
                                                <Button Grid.Column="4" Content="应用到本类" Click="ButtonApplyBackgroundCategory_Click"/>
                                            </Grid>

                                            <Separator Opacity="0.35"/>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition Width="96"/>
                                                                <ColumnDefinition Width="auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Header}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}"/>
                                                            <Border Grid.Column="1"
                                                                    Width="24"
                                                                    Height="24"
                                                                    CornerRadius="4"
                                                                    Margin="0,0,8,0"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Background="{Binding Style.Color, Converter={StaticResource HexColorBrushConverter}}"/>
                                                            <TextBox Grid.Column="2"
                                                                     Width="88"
                                                                     Height="32"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding Style.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     LostFocus="CustomBackgroundColorTextBox_LostFocus"
                                                                     KeyDown="CustomBackgroundColorTextBox_KeyDown"/>
                                                            <card:NumberSettingEditor Grid.Column="3"
                                                                                      Margin="12,0,0,0"
                                                                                      Value="{Binding Style.Opacity, Mode=TwoWay}"
                                                                                      Minimum="0"
                                                                                      Maximum="100"
                                                                                      TickFrequency="1"
                                                                                      Unit="%"
                                                                                      NumberFormat="0"
                                                                                      InputWidth="56"
                                                                                      ValueChanged="CustomBackgroundItem_ValueChanged"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ikw:SimpleStackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Border>
                <Label FontSize="14" Margin="12,8,0,0" Content="标题栏" Opacity="0.8"/>
                <card:ToggleSwitchCard x:Name="CardIsComponentTitleTextHidden" Icon="{x:Static ui:FluentSystemIcons.TextFontSize_20_Regular}"
                                       Header="隐藏组件标题文字" Tip="隐藏后，组件底部标题栏背景会收缩到按钮区域"
                                       IsOn="{Binding IsComponentTitleTextHidden, Mode=TwoWay}"
                                       IsResetButtonVisible="True" ResetClicked="CardIsComponentTitleTextHidden_ResetClicked"
                                       Toggled="ToggleSwitchIsComponentTitleTextHidden_Toggled"/>
                <card:GenericSettingsCard x:Name="CardLookMode" Icon="{x:Static ui:FluentSystemIcons.ContentViewGallery_20_Regular}" Header="显示模式" Tip="此设置项决定要显示的内容，如需隐藏小黑板，请设置为简约模式"
                                          IsResetButtonVisible="True" ResetClicked="CardLookMode_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ComboBox Width="180" SelectedIndex="{Binding LookMode}" SelectionChanged="ComboBoxLookMode_SelectionChanged">
                            <ComboBoxItem>完整（默认）</ComboBoxItem>
                            <ComboBoxItem>简约（顶部为时钟）</ComboBoxItem>
                            <ComboBoxItem>简约（顶部为看板）</ComboBoxItem>
                            <ComboBoxItem>简约（仅课程表）</ComboBoxItem>
                        </ComboBox>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <card:ToggleSwitchCard x:Name="CardIsLauncherEnabled" Icon="{x:Static ui:FluentSystemIcons.ContentViewGallery_20_Regular}"
                                       Header="显示启动台" Tip="关闭后隐藏底部启动台区域"
                                       IsOn="{Binding IsLauncherEnabled, Mode=TwoWay}"
                                       IsResetButtonVisible="True" ResetClicked="CardIsLauncherEnabled_ResetClicked"
                                       Toggled="ToggleSwitchIsLauncherEnabled_Toggled"/>
                <card:GenericSettingsCard x:Name="CardWindowHeightAdjustment" Icon="{x:Static ui:FluentSystemIcons.ScaleFit_20_Regular}"
                                          Header="自定义主面板高度" Tip="关闭时使用全高窗口并应用 ClassIsland 避让"
                                          IsResetButtonVisible="True" ResetClicked="CardWindowHeightAdjustment_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <card:NumberSettingEditor Value="{Binding WindowHeightPercent, Mode=TwoWay}"
                                                      Minimum="30" Maximum="100" TickFrequency="1"
                                                      Unit="%" NumberFormat="0"
                                                      IsEnabled="{Binding IsWindowHeightAdjustmentEnabled}"
                                                      ValueChanged="SliderWindowHeightPercent_ValueChanged"/>
                            <ui:ToggleSwitch MinWidth="0" IsOn="{Binding IsWindowHeightAdjustmentEnabled, Mode=TwoWay}"
                                             Toggled="ToggleSwitchIsWindowHeightAdjustmentEnabled_Toggled"/>
                        </ikw:SimpleStackPanel>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <card:GenericSettingsCard x:Name="CardWindowVerticalAlignment" Icon="{x:Static ui:FluentSystemIcons.ContentViewGallery_20_Regular}" Header="垂直对齐"
                                          IsEnabled="{Binding IsWindowHeightAdjustmentEnabled}"
                                          IsResetButtonVisible="True" ResetClicked="CardWindowVerticalAlignment_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ComboBox Width="180" SelectedIndex="{Binding WindowVerticalAlignment}" SelectionChanged="ComboBoxWindowVerticalAlignment_SelectionChanged">
                            <ComboBoxItem>上对齐</ComboBoxItem>
                            <ComboBoxItem>下对齐</ComboBoxItem>
                        </ComboBox>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <card:GenericSettingsCard x:Name="CardTargetMonitor" Icon="{x:Static ui:FluentSystemIcons.Desktop_20_Regular}" Header="显示器"
                                          IsResetButtonVisible="True" ResetClicked="CardTargetMonitor_ResetClicked">
                    <card:GenericSettingsCard.CardContent>
                        <ComboBox MinWidth="180" ItemsSource="{Binding Monitors, RelativeSource={RelativeSource AncestorType=local:LookSettingsPage}}" SelectedIndex="{Binding TargetMonitor}" DisplayMemberPath="Name" SelectionChanged="ComboBoxMonitor_SelectionChanged"/>
                    </card:GenericSettingsCard.CardContent>
                </card:GenericSettingsCard>
                <card:ToggleSwitchCard x:Name="ToggleSwitchIsWindowChromeDisabled" 
                                       Icon="{x:Static ui:FluentSystemIcons.Code_20_Regular}" 
                                       Header="禁用 WindowChrome" Tip="开启后，将使用 AllowTransparency 代替 WindowChrome。若黑板贴背景完全不透明，请开启此设置项"
                                       IsOn="{Binding IsWindowChromeDisabled, Mode=TwoWay}"
                                       IsResetButtonVisible="True" ResetClicked="ToggleSwitchIsWindowChromeDisabled_ResetClicked"
                                       Toggled="ToggleSwitchIsWindowChromeDisabled_Toggled"/>
            </ikw:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>
</Page>
